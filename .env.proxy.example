# Cloudflare代理环境配置

# 应用URL配置
NEXT_PUBLIC_SITE_URL=https://still-legal-ai.gocdn.dpdns.org

# Supabase配置 (确保使用HTTPS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 代理相关配置
NEXT_PUBLIC_CLOUDFLARE_PROXY=true
NEXT_PUBLIC_DOMAIN_STILL_LEGAL_AI=still-legal-ai.gocdn.dpdns.org

# Cookie配置
NEXT_PUBLIC_COOKIE_DOMAIN=.still-legal-ai.gocdn.dpdns.org
NEXT_PUBLIC_COOKIE_SAME_SITE=none
NEXT_PUBLIC_COOKIE_SECURE=true

# 开发环境配置
NEXT_PUBLIC_DEV_MODE=false
NODE_ENV=production

# 调试选项
NEXT_PUBLIC_DEBUG_PROXY=true
NEXT_PUBLIC_LOG_COOKIE_SETTINGS=true